NODE_ENV=development
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
ALLOWED_ORIGINS=http://localhost:3000

# Chave exclusiva para criptografar exportações de privacidade.
# Em produção use pelo menos 32 caracteres aleatórios e guarde apenas no Render.
PRIVACY_EXPORT_SECRET=troque-por-outro-segredo-longo-e-aleatorio
PRIVACY_EXPORT_EXPIRATION_HOURS=24
RETENTION_BATCH_SIZE=3000
GUARDIAN_QUEUE_RETENTION_DAYS=60
GUARDIAN_ANALYSIS_RETENTION_DAYS=180
WORKER_HEARTBEAT_RETENTION_DAYS=30
NOTIFICATION_CIRCUIT_RETENTION_DAYS=90

# Servidor único: all. Separado: api no serviço HTTP e worker no Background Worker.
PROCESS_ROLE=all
# Ao usar PROCESS_ROLE=api, confirme que existe um worker separado ativo.
EXTERNAL_WORKER_ENABLED=false
MIGRATE_ON_START=false

# MFA obrigatório para o administrador geral em produção.
ADMIN_MFA_REQUIRED=true
# Use apenas se o cadastro do administrador não possuir e-mail.
ADMIN_MFA_EMAIL=administrador@empresa.com
